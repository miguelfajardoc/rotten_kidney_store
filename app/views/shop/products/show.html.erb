<% content_for :title, @product.title %>

<%= link_to "← Back to Tienda", shop_root_path, class: "mb-8 inline-block text-xs font-medium uppercase tracking-widest text-stone-400 transition-colors hover:text-white" %>

<div class="grid gap-10 lg:grid-cols-2">
  <div data-controller="gallery">
    <div class="aspect-square overflow-hidden rounded-lg bg-slate-800">
      <% if @product.images.attached? %>
        <%= image_tag @product.images.first, data: { gallery_target: "main" },
              class: "h-full w-full object-cover" %>
      <% else %>
        <div class="flex h-full w-full items-center justify-center text-stone-600">No image</div>
      <% end %>
    </div>

    <% if @product.images.size > 1 %>
      <div class="mt-4 grid grid-cols-5 gap-3">
        <% @product.images.each do |image| %>
          <button type="button"
                  data-gallery-target="thumb"
                  data-action="gallery#select"
                  data-gallery-full-url="<%= url_for(image) %>"
                  class="aspect-square overflow-hidden rounded-md bg-slate-800 ring-sky-500 ring-offset-2 ring-offset-slate-900 transition hover:opacity-80">
            <%= image_tag image, class: "h-full w-full object-cover" %>
          </button>
        <% end %>
      </div>
    <% end %>
  </div>

  <div>
    <h1 class="text-3xl font-bold tracking-tight text-white"><%= @product.title %></h1>
    <p class="mt-3 text-xl text-stone-300"><%= number_to_currency(@product.price) %> COP</p>

    <% if @product.sold_out? %>
      <div class="mt-6 w-full rounded-lg border border-slate-700 py-3 text-center text-sm font-semibold uppercase tracking-widest text-stone-500">
        <%= t(".sold_out") %>
      </div>
    <% else %>
      <%
        whatsapp_text = t(".whatsapp_message",
              title: @product.title,
              price: number_with_delimiter(@product.price.to_i, delimiter: "."),
              url: shop_product_url(@product))
        whatsapp_url = "https://wa.me/#{Rails.application.config.business.whatsapp_phone}?text=#{CGI.escape(whatsapp_text)}"
      %>
      <%= link_to whatsapp_url, target: "_blank", rel: "noopener",
            class: "mt-6 flex w-full items-center justify-center gap-2 rounded-lg bg-[#25D366] py-3 text-sm font-semibold uppercase tracking-widest text-white transition-colors hover:bg-[#1ebe5d]" do %>
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51l-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.71.306 1.263.489 1.694.625.712.227 1.36.195 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
        </svg>
        <%= t(".buy") %>
      <% end %>
    <% end %>

    <dl class="mt-10 space-y-4 border-t border-slate-800 pt-8 text-sm">
      <% [
           ["Product kind", @product.product_kind&.name],
           ["Character",    @product.character&.name],
           ["Material",     @product.product_kind&.material],
           ["Description",  @product.product_kind&.description],
           ["Notes",        @product.aditional_info]
         ].each do |label, value| %>
        <% next if value.blank? %>
        <div class="flex gap-4">
          <dt class="w-32 shrink-0 uppercase tracking-widest text-stone-500"><%= label %></dt>
          <dd class="text-stone-300"><%= value %></dd>
        </div>
      <% end %>
    </dl>
  </div>
</div>
