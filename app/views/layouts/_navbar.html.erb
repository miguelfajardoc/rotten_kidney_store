<%
  nav_links = [
    ["Products",      products_path],
    ["Characters",    characters_path],
    ["Product kinds", product_kinds_path],
    ["Sizes",         sizes_path]
  ]
  base_link  = "px-3 py-2 rounded-lg text-sm font-medium transition-colors duration-150"
  active_cls = "#{base_link} bg-sky-700 text-white shadow-inner"
  idle_cls   = "#{base_link} text-stone-300 hover:text-white hover:bg-slate-700"
%>

<nav class="sticky top-0 z-40 mb-8 rounded-2xl border border-slate-700/80 bg-slate-800/95 shadow-lg backdrop-blur supports-[backdrop-filter]:bg-slate-800/80">
  <div class="flex flex-wrap items-center gap-x-6 gap-y-3 px-5 py-3">
    <%= link_to root_path, class: "flex items-center gap-2 text-white font-bold tracking-tight" do %>
      <span class="flex h-8 w-8 items-center justify-center rounded-lg bg-sky-700 text-base">🫘</span>
      <span class="text-lg">Rotten Kidney</span>
    <% end %>

    <div class="flex flex-wrap items-center gap-1 sm:gap-2">
      <% nav_links.each do |label, path| %>
        <%= link_to label, path, class: (current_page?(path) ? active_cls : idle_cls) %>
      <% end %>
    </div>

    <% if Current.user %>
      <div class="ms-auto">
        <%= button_to session_path, method: :delete,
              class: "group inline-flex items-center gap-2 rounded-lg border border-slate-600 bg-slate-900/40 px-4 py-2 text-sm font-medium text-stone-300 transition-colors duration-150 hover:border-red-600 hover:bg-red-600 hover:text-white cursor-pointer" do %>
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="h-4 w-4">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 9V5.25A2.25 2.25 0 0 0 13.5 3h-6a2.25 2.25 0 0 0-2.25 2.25v13.5A2.25 2.25 0 0 0 7.5 21h6a2.25 2.25 0 0 0 2.25-2.25V15M12 9l3 3m0 0-3 3m3-3H2.25" />
          </svg>
          Logout
        <% end %>
      </div>
    <% else %>
      <div class="ms-auto">
        <%= button_to "Login", new_session_path,
              class: "inline-flex items-center gap-2 rounded-lg bg-sky-700 px-4 py-2 text-sm font-medium text-stone-100 transition-colors duration-150 hover:bg-sky-600 cursor-pointer" %>
      </div>
    <% end %>
  </div>
</nav>
