<% content_for :title, "New product" %>

<h1 class="text-xl font-bold p-5 text-white">New product</h1>

<div class="p-5 bg-slate-800 w-fit">
  <%= render "form", product: @product %>

  <div class="flex justify-start mt-4">
    <p class="bg-sky-700 rounded-lg text-stone-200 hover:bg-sky-600 w-fit">
      <%= link_to "Back to products", products_path, class: "p-3 block" %>
    </p>
  </div>
</div>
