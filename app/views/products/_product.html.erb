<div id="<%= dom_id product %>">
  <p>
    <strong>Stock:</strong>
    <%= product.stock %>
  </p>

  <p>
    <strong>Price:</strong>
    <%= product.price %>
  </p>

  <p>
    <strong>Cost:</strong>
    <%= product.cost %>
  </p>

  <p>
    <strong>Aditional info:</strong>
    <%= product.aditional_info %>
  </p>

  <p>
    <strong>Character:</strong>
    <%= product.character.name %>
  </p>

  <p>
    <strong>Product kind:</strong>
    <%= product.product_kind.name %>
  </p>

</div>
