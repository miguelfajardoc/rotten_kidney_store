<p style="color: green"><%= notice %></p>

<% content_for :title, "Products" %>

<h1 class="text-xl font-bold p-5 text-white">Products</h1>

<div id="products" class="grid grid-cols-3 gap-4">
  <% @products.each do |product| %>
    <div class="p-5 bg-slate-800">
      <%= render product %>
      <div class="flex justify-start items-center" data-controller="modal">
        <p class="bg-sky-700 rounded-lg text-stone-200 hover:bg-sky-600 w-fit mr-3">
          <%= link_to "Show this product", product, class:"p-3" %>
        </p>
        <p class="bg-sky-700 rounded-lg text-stone-200 hover:bg-sky-600 w-fit mr-3">
          <%= link_to "Edit this product", edit_product_path(product), class:"p-3" %>
        </p>
        <button type="button"
                data-action="modal#open"
                class="bg-red-700 rounded-lg text-stone-200 hover:bg-red-600 w-fit px-3 cursor-pointer">
          Delete this product
        </button>

        <div data-modal-target="dialog"
             data-action="click->modal#closeBackground"
             class="hidden fixed inset-0 z-50 flex items-center justify-center bg-black/50">
          <div class="bg-slate-800 text-stone-200 rounded-lg p-6 w-80 shadow-xl">
            <h2 class="text-lg font-bold text-white mb-2">Delete product</h2>
            <p class="mb-5">Are you sure you want to delete this product? This action cannot be undone.</p>
            <div class="flex justify-end items-center">
              <button type="button"
                      data-action="modal#close"
                      class="bg-slate-600 rounded-lg text-stone-200 hover:bg-slate-500 w-fit p-3 cursor-pointer mr-3">
                Cancel
              </button>
              <%= button_to "Delete", product, method: :delete,
                    class: "bg-red-700 rounded-lg text-stone-200 hover:bg-red-600 w-fit p-3 cursor-pointer" %>
            </div>
          </div>
        </div>
      </div>
    </div>
  <% end %>
</div>

<p class="bg-sky-700 rounded-lg text-stone-200 hover:bg-sky-600 w-fit mt-4">
  <%= link_to "New product", new_product_path, class: "p-3 block" %>
</p>
