<p style="color: green"><%= notice %></p>

<% content_for :title, "Products" %>

<h1 class="text-xl font-bold p-5 text-white">Products</h1>

<div id="products" class="grid grid-cols-3 gap-4">
  <% @products.each do |product| %>
    <div class="p-5 bg-slate-800">
      <%= render product %>
      <div class="flex justify-start">
        <p class="bg-sky-700 rounded-lg text-stone-200 hover:bg-sky-600 w-fit mr-3">
          <%= link_to "Show this product", product, class:"p-3" %>
        </p>
        <p class="bg-sky-700 rounded-lg text-stone-200 hover:bg-sky-600 w-fit">
          <%= link_to "Edit this product", edit_product_path(product), class:"p-3" %>
        </p>
      </div>
    </div>
  <% end %>
</div>

<%= link_to "New product", new_product_path %>
