<p style="color: green"><%= notice %></p>

<% content_for :title, "Sizes" %>

<h1 class="text-xl font-bold p-5 text-white">Sizes</h1>

<div id="sizes" class="grid grid-cols-3 gap-4">
  <% @sizes.each do |size| %>
    <div class="p-5 bg-slate-800">
      <%= render "size", size: size %>
      <div class="flex justify-start">
        <p class="bg-sky-700 rounded-lg text-stone-200 hover:bg-sky-600 w-fit mr-3">
          <%= link_to "Show this size", [ :admin, size ], class: "p-3 block" %>
        </p>
        <p class="bg-sky-700 rounded-lg text-stone-200 hover:bg-sky-600 w-fit">
          <%= link_to "Edit this size", edit_admin_size_path(size), class: "p-3 block" %>
        </p>
      </div>
    </div>
  <% end %>
</div>

<p class="bg-sky-700 rounded-lg text-stone-200 hover:bg-sky-600 w-fit mt-4">
  <%= link_to "New size", new_admin_size_path, class: "p-3 block" %>
</p>
