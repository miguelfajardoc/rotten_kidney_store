<%= form_with(model: [ :admin, product ], class: "text-stone-200") do |form| %>
  <% if product.errors.any? %>
    <div class="bg-red-900 text-stone-200 rounded-lg p-4 mb-4">
      <h2 class="font-bold"><%= pluralize(product.errors.count, "error") %> prohibited this product from being saved:</h2>

      <ul class="list-disc list-inside">
        <% product.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="mb-4">
    <%= form.label :stock, class: "block mb-1" %>
    <%= form.number_field :stock, class: "bg-slate-700 text-stone-200 rounded-lg p-2 w-full" %>
  </div>

  <div class="mb-4">
    <%= form.label :price, class: "block mb-1" %>
    <%= form.text_field :price, class: "bg-slate-700 text-stone-200 rounded-lg p-2 w-full" %>
  </div>

  <div class="mb-4">
    <%= form.label :cost, class: "block mb-1" %>
    <%= form.text_field :cost, class: "bg-slate-700 text-stone-200 rounded-lg p-2 w-full" %>
  </div>

  <div class="mb-4">
    <%= form.label :aditional_info, class: "block mb-1" %>
    <%= form.text_field :aditional_info, class: "bg-slate-700 text-stone-200 rounded-lg p-2 w-full" %>
  </div>

  <div class="mb-4">
    <%= form.label :character_id, class: "block mb-1" %>
    <%= form.collection_select :character_id, Character.all, :id, :name, { prompt: true }, class: "bg-slate-700 text-stone-200 rounded-lg p-2 w-full" %>
  </div>

  <div class="mb-4">
    <%= form.label :product_kind_id, class: "block mb-1" %>
    <%= form.collection_select :product_kind_id, ProductKind.all, :id, :name, { prompt: true }, class: "bg-slate-700 text-stone-200 rounded-lg p-2 w-full" %>
  </div>

  <% if product.images.attached? %>
    <div class="mb-4">
      <span class="block mb-1">Current images</span>
      <div class="grid grid-cols-3 gap-3">
        <% product.images.each do |image| %>
          <label class="group relative block cursor-pointer">
            <%= image_tag image, class: "w-full h-32 object-cover rounded-lg border border-slate-700" %>
            <span class="absolute inset-0 rounded-lg bg-black/0 transition-colors group-has-[:checked]:bg-black/60"></span>
            <span class="absolute bottom-2 left-2 flex items-center gap-1.5 rounded-lg bg-slate-900/80 px-2 py-1 text-sm text-stone-200">
              <%= check_box_tag "remove_image_ids[]", image.id, false, class: "accent-red-600" %>
              Remove
            </span>
          </label>
        <% end %>
      </div>
    </div>
  <% end %>

  <div class="mb-4">
    <%= form.label :images, "Add images (optional)", class: "block mb-1" %>
    <%= form.file_field :images, multiple: true, accept: "image/*", class: "bg-slate-700 text-stone-200 rounded-lg p-2 w-full" %>
  </div>

  <div>
    <%= form.submit class: "bg-sky-700 rounded-lg text-stone-200 hover:bg-sky-600 w-fit p-3 cursor-pointer" %>
  </div>
<% end %>
