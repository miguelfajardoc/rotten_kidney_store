<% content_for :title, "Editing size" %>

<h1 class="text-xl font-bold p-5 text-white">Editing size</h1>

<div class="p-5 bg-slate-800 w-fit">
  <%= render "form", size: @size %>

  <div class="flex justify-start mt-4">
    <p class="bg-sky-700 rounded-lg text-stone-200 hover:bg-sky-600 w-fit mr-3">
      <%= link_to "Show this size", @size, class: "p-3 block" %>
    </p>
    <p class="bg-sky-700 rounded-lg text-stone-200 hover:bg-sky-600 w-fit">
      <%= link_to "Back to sizes", sizes_path, class: "p-3 block" %>
    </p>
  </div>
</div>
