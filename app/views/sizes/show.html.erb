<p style="color: green"><%= notice %></p>

<% content_for :title, "Size" %>

<h1 class="text-xl font-bold p-5 text-white">Size</h1>

<div class="p-5 bg-slate-800 w-fit">
  <%= render @size %>

  <div class="flex justify-start items-center">
    <p class="bg-sky-700 rounded-lg text-stone-200 hover:bg-sky-600 w-fit mr-3">
      <%= link_to "Edit this size", edit_size_path(@size), class: "p-3 block" %>
    </p>
    <p class="bg-sky-700 rounded-lg text-stone-200 hover:bg-sky-600 w-fit mr-3">
      <%= link_to "Back to sizes", sizes_path, class: "p-3 block" %>
    </p>
    <%= button_to "Destroy this size", @size, method: :delete, class: "bg-red-700 rounded-lg text-stone-200 hover:bg-red-600 w-fit p-3" %>
  </div>
</div>
