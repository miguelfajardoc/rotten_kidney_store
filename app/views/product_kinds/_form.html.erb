<%= form_with(model: product_kind) do |form| %>
  <% if product_kind.errors.any? %>
    <div style="color: red">
      <h2><%= pluralize(product_kind.errors.count, "error") %> prohibited this product_kind from being saved:</h2>

      <ul>
        <% product_kind.errors.each do |error| %>
