<p style="color: green"><%= notice %></p>

<% content_for :title, "Characters" %>

<h1 class="text-xl font-bold p-5 text-white">Characters</h1>

<div id="characters" class="grid grid-cols-3 gap-4">
  <% @characters.each do |character| %>
    <div class="p-5 bg-slate-800">
      <%= render character %>
      <div class="flex justify-start">
        <p class="bg-sky-700 rounded-lg text-stone-200 hover:bg-sky-600 w-fit mr-3">
          <%= link_to "Show this character", character, class: "p-3 block" %>
        </p>
        <p class="bg-sky-700 rounded-lg text-stone-200 hover:bg-sky-600 w-fit">
          <%= link_to "Edit this character", edit_character_path(character), class: "p-3 block" %>
        </p>
      </div>
    </div>
  <% end %>
</div>

<p class="bg-sky-700 rounded-lg text-stone-200 hover:bg-sky-600 w-fit mt-4">
  <%= link_to "New character", new_character_path, class: "p-3 block" %>
</p>
