<% content_for :title, "Sign in" %>

<div class="mx-auto mt-10 max-w-sm text-stone-200">
  <div class="mb-8 flex items-center gap-2 text-white">
    <span class="flex h-9 w-9 items-center justify-center rounded-lg bg-sky-700 text-lg">🫘</span>
    <span class="text-xl font-bold tracking-tight">Rotten Kidney</span>
  </div>

  <h1 class="mb-6 text-2xl font-bold tracking-tight text-white">Sign in</h1>

  <% if flash[:alert] %>
    <div class="mb-4 rounded-lg border border-red-800 bg-red-900/60 px-4 py-3 text-sm text-red-100"><%= flash[:alert] %></div>
  <% end %>
  <% if flash[:notice] %>
    <div class="mb-4 rounded-lg border border-emerald-800 bg-emerald-900/50 px-4 py-3 text-sm text-emerald-100"><%= flash[:notice] %></div>
  <% end %>

  <%= form_with url: session_path, class: "space-y-4" do |form| %>
    <div>
      <%= form.label :email_address, "Email", class: "mb-1 block text-sm font-medium text-stone-300" %>
      <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username",
            placeholder: "you@example.com", value: params[:email_address],
            class: "w-full rounded-lg border border-slate-700 bg-slate-800 px-3 py-2 text-stone-100 placeholder-stone-500 outline-none transition-colors focus:border-sky-600 focus:ring-1 focus:ring-sky-600" %>
    </div>

    <div>
      <%= form.label :password, "Password", class: "mb-1 block text-sm font-medium text-stone-300" %>
      <%= form.password_field :password, required: true, autocomplete: "current-password",
            placeholder: "••••••••", maxlength: 72,
            class: "w-full rounded-lg border border-slate-700 bg-slate-800 px-3 py-2 text-stone-100 placeholder-stone-500 outline-none transition-colors focus:border-sky-600 focus:ring-1 focus:ring-sky-600" %>
    </div>

    <%= form.submit "Sign in",
          class: "w-full cursor-pointer rounded-lg bg-sky-700 px-4 py-2 text-sm font-semibold text-white transition-colors hover:bg-sky-600" %>
  <% end %>

  <p class="mt-6 text-sm text-stone-400">
    <%= link_to "Forgot password?", new_password_path, class: "text-sky-400 transition-colors hover:text-sky-300" %>
  </p>
</div>
